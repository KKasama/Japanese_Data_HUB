{
  "admin_email": "ops@example.org",
  "user_agent": "jhub/0.1 (+ops@example.org)",
  "hub_base_url": "https://hub.example.org/oai",
  "db": "data/hub.sqlite",
  "store": {
    "type": "local",
    "path": "data/store"
  },
  "store_s3_example": {
    "type": "s3",
    "bucket": "jhub-raw",
    "endpoint_url": "https://s3.ap-northeast-1.wasabisys.com",
    "prefix": "raw",
    "region": "ap-northeast-1",
    "access_key": "(環境変数等から注入)",
    "secret_key": "(環境変数等から注入)"
  },
  "abstracts": {
    "_説明": "抄録の出力: off=出さない / permitted_only=第三者利用が可と分かるものだけ / include=出す。変更後は ingest --reprocess",
    "irdb": "include",
    "jalc": "off"
  },
  "ror": {
    "_説明": "生データにRORが無い所属だけ、ROR公式APIで照合して付与。enabled=trueでingest時にキャッシュを適用。API照会は enrich-ror",
    "enabled": true,
    "min_score": 0.9,
    "delay": 0.2,
    "client_id": null,
    "overrides": null
  },
  "irdb": {
    "base_url": "https://irdb.nii.ac.jp/oai/",
    "metadata_prefix": "jpcoar_2.0",
    "set": "irdb",
    "delay": 1.0
  },
  "jalc": {
    "base_url": "https://api.japanlinkcenter.org",
    "max_rps": 1.0,
    "site_id": "SI/JST.JSTAGE"
  }
}
